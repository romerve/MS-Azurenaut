<!--
  POC: log every LLM prompt and response through the LLM interaction logger function.

  inbound  -> POST {llm-logger-url}/api/llm-log/request   (the prompt, as sent by the client)
  outbound -> POST {llm-logger-url}/api/llm-log/response  (the LLM response, as returned by the backend)

  Both calls share x-interaction-id = context.RequestId. send-one-way-request is fire-and-forget, so logging
  never delays or fails the LLM call. preserveContent: true leaves the original bodies untouched.

  Named values: llm-logger-url (function app URL) and llm-logger-key (function key, marked secret).
-->
<policies>
    <inbound>
        <base />
        <send-one-way-request mode="new">
            <set-url>{{llm-logger-url}}/api/llm-log/request</set-url>
            <set-method>POST</set-method>
            <set-header name="x-functions-key" exists-action="override">
                <value>{{llm-logger-key}}</value>
            </set-header>
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-header name="x-interaction-id" exists-action="override">
                <value>@(context.RequestId.ToString())</value>
            </set-header>
            <!-- Azure OpenAI puts the deployment name in the URL rather than the body. -->
            <set-header name="x-model" exists-action="override">
                <value>@(context.Request.MatchedParameters.GetValueOrDefault("deployment-id", ""))</value>
            </set-header>
            <set-body>@(context.Request.Body.As<string>(preserveContent: true))</set-body>
        </send-one-way-request>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <send-one-way-request mode="new">
            <set-url>{{llm-logger-url}}/api/llm-log/response</set-url>
            <set-method>POST</set-method>
            <set-header name="x-functions-key" exists-action="override">
                <value>{{llm-logger-key}}</value>
            </set-header>
            <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
            </set-header>
            <set-header name="x-interaction-id" exists-action="override">
                <value>@(context.RequestId.ToString())</value>
            </set-header>
            <set-header name="x-model" exists-action="override">
                <value>@(context.Request.MatchedParameters.GetValueOrDefault("deployment-id", ""))</value>
            </set-header>
            <set-header name="x-status-code" exists-action="override">
                <value>@(context.Response.StatusCode.ToString())</value>
            </set-header>
            <set-header name="x-latency-ms" exists-action="override">
                <value>@(((long)context.Elapsed.TotalMilliseconds).ToString())</value>
            </set-header>
            <set-body>@(context.Response.Body.As<string>(preserveContent: true))</set-body>
        </send-one-way-request>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
