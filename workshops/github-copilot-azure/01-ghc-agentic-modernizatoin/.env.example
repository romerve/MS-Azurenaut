# Only required for the optional SQL Server profile (`scripts/start.zsh --sql`).
# Use a local-only secret that satisfies SQL Server password complexity.
SQL_PASSWORD=replace-with-a-local-only-strong-password

# SQL Server 2022 is amd64-only. On Apple silicon, emulation may be slow or
# unreliable; the default SQLite-backed flow is the portable fallback.
SQL_PLATFORM=linux/amd64
