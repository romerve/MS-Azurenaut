{
  "name": "C# (.NET 8) - Azure Functions (Codespaces-safe)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-azurefunctions",
        "Azurite.azurite"
      ],
      "settings": {
        "omnisharp.useModernNet": true,
        "azureFunctions.projectRuntime": "~4"
      }
    }
  },

  "forwardPorts": [7071, 10000, 10001, 10002],
  "portsAttributes": {
    "7071": { "label": "Azure Functions Host", "onAutoForward": "notify" }
  },

  // IMPORTANT: keep postCreate very small to avoid recovery-mode triggers.
  // You can run 'npm i -g azure-functions-core-tools@4' manually in the terminal after the Codespace boots.
  "postCreateCommand": "bash -lc 'set -e; dotnet --version; node -v; npm -v; echo \"Container ready\"'"
}
