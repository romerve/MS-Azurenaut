{
  "name": "C# (.NET 8) - Azure Functions + Durable Functions (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-8.0",

  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-azuretools.vscode-azurefunctions",
        "ms-azuretools.vscode-azureresourcegroups",
        "Azurite.azurite",
        "ms-vscode.powershell"
      ],
      "settings": {
        "omnisharp.useModernNet": true,
        "azureFunctions.projectRuntime": "~4"
      }
    }
  },

  "forwardPorts": [7071, 10000, 10001, 10002],
  "portsAttributes": {
    "7071": { "label": "Azure Functions Host", "onAutoForward": "notify" },
    "10000": { "label": "Azurite Blob", "onAutoForward": "silent" },
    "10001": { "label": "Azurite Queue", "onAutoForward": "silent" },
    "10002": { "label": "Azurite Table", "onAutoForward": "silent" }
  },

  "remoteUser": "vscode",

  "postCreateCommand": "bash -lc 'set -e; node -v; npm -v; if ! command -v func >/dev/null 2>&1; then npm install -g azure-functions-core-tools@4 --unsafe-perm true; fi; dotnet --info; func --version'"
}
